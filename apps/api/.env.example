# ============ SERVER ============
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ============ DATABASE ============
MONGODB_URI=YOUR_MONGODB_URI_HERE

# ============ JWT ============
JWT_SECRET=tbi_super_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=tbi_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============ EMAIL ============
# Leave EMAIL_HOST blank to use Ethereal test mode
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=TBI Platform <noreply@tbi.org>

# ============ SECURITY ============
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
